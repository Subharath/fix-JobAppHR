{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "font-awesome@6.5.2",
      "destination": "wwwroot/lib/font-awesome/"
    },
    {
      "library": "datatable@2.0.2",
      "destination": "wwwroot/lib/datatable/"
    },
    {
      "library": "sweetalert@2.1.2",
      "destination": "wwwroot/lib/sweetalert/"
    },
    {
      "library": "datatables.net@2.1.2",
      "destination": "wwwroot/lib/datatables.net/"
    },
    {
      "provider": "jsdelivr",
      "library": "@microsoft/signalr@6.0.25",
      "destination": "wwwroot/lib/signalr/",
      "files": [
        "dist/browser/signalr.min.js"
      ]
    }
  ]
}