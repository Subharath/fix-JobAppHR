@model IEnumerable<JobAppHR.Models.FreezeSummary>

<table class="table table-striped table-bordered dt-responsive compact nowrap" id="datagrid">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IntakeCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FreezeNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FreezedOn)
            </th>
            <th style="text-align: center">
                Non-Eligible
            </th>
            <th style="text-align: center">
                Eligible
            </th>
            <th style="text-align: center">
                Short Listed
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IntakeCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FreezeNo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FreezedOn)
                </td>
                <td style="text-align: center">
                    @Html.ActionLink(" ", "ShowFail", new { intakeCode=item.IntakeCode, freezeNo=item.FreezeNo }, new { @class="fa fa-user-times", @style="text-decoration:none;color:red;", title = "List", target = "_blank" })
                </td>
                <td style="text-align: center">
                    @Html.ActionLink(" ", "ShowFinal", new { intakeCode=item.IntakeCode, freezeNo=item.FreezeNo }, new { @class="fa fa-users", @style="text-decoration:none;color:green;", title = "List", target = "_blank" })
                </td>
                <td style="text-align: center">
                    @Html.ActionLink(" ", "ShortListed", new { intakeCode = item.IntakeCode, freezeNo = item.FreezeNo }, new { @class = "fa-solid fa-flag", @style = "text-decoration:none;color:blue;", title = "Short Listed", target = "_blank" })
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts
    {
        <script>
            $(document).ready(function () {
                $('#datagrid').DataTable({
                    "pageLength": 50,
                    columnDefs: [
                        { targets: [$('thead tr th').length - 1], "orderable": false, },
                        { targets: [$('thead tr th').length - 2], "orderable": false, }
                    ],
                });

                var val = '@ViewBag.Message';
                if (val != "")
                    $('.alert').show();
                else
                    $('.alert').hide();
            });

        </script>
}
