@model IEnumerable<JobAppHR.Models.User>

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    table.dataTable thead tr {
        background-color: lightgrey;
    }
</style>

<h1>@ViewData["Title"]</h1>
<p>
    <a asp-action="Create" class="btn btn-outline-primary btn-sm"><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Create New</a>
</p>
<div class="alert alert-info">
    <h5 style="text-align: center">@ViewBag.Message</h5>
</div>
<table class="table table-striped table-bordered dt-responsive compact nowrap" id="datagrid">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GroupName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ActiveStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="text-left">
                    @Html.DisplayFor(modelItem => item.UserId)
                    -
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GroupName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ActiveStatus)
                </td>
                <td>
                    @Html.ActionLink(" ", "Edit", new { id = item.UserId }, new { @class = "fa fa-pencil", @style = "text-decoration:none;", title = "Edit" })
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts
{
    <script>
        $(document).ready(function () {
            $('#datagrid').DataTable({
                "pageLength": 50,
                columnDefs: [
                    { targets: [0], className: 'text-left' },
                    { targets: [$('thead tr th').length - 1], "orderable": false, }
                ],
            });

            var val = '@ViewBag.Message';
            if (val != "")
                $('.alert').show();
            else
                $('.alert').hide();
        });

    </script>
}

