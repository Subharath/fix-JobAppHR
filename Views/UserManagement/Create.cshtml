@model JobAppHR.Models.User

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>User</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row">
                <div class="col-2 form-group">
                    <label asp-for="UserId" class="control-label"></label>
                    <input asp-for="UserId" class="form-control form-control-sm" maxlength="6"/>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
                <div class="col-5 form-group">
                    <label asp-for="UserName" class="control-label"></label>
                    <input asp-for="UserName" class="form-control form-control-sm" maxlength="50" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="col-5 form-group">
                    <label asp-for="UserEmail" class="control-label"></label>
                    <input asp-for="UserEmail" class="form-control form-control-sm" maxlength="50" />
                    <span asp-validation-for="UserEmail" class="text-danger"></span>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-3 form-group">
                    <label asp-for="UserGroup" class="control-label"></label>
                    <select asp-for="UserGroup" asp-items="@ViewBag.UserGroup" class="form-select form-select-sm">
                    </select>
                    <span asp-validation-for="UserGroup" class="text-danger"></span>
                </div>
                <div class="col-3 form-group">
                    <label asp-for="ActiveStatus" class="control-label"></label>
                    <select asp-for="ActiveStatus" class="form-select form-select-sm">
                        <option selected>ACTIVE</option>
                        <option>INACTIVE</option>
                    </select>
                    <span asp-validation-for="ActiveStatus" class="text-danger"></span>
                </div>
            </div>
            <br />
            
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
