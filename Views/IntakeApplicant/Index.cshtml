<link href="~/lib/bootstrap-select/css/bootstrap-select.min.css" rel="stylesheet" />

<form asp-action="ViewApplicantList">
    <div class="form-group d-flex align-items-center">
        <div class="me-4">
            <label class="control-label">Select Intake Code</label>
        </div>
        <div class="me-4">
            <select name="IntakeCode" id="IntakeCode" class="selectpicker">
                <optgroup label="Normal Intakes">
                    @{
                        foreach (var item in (List<string>)ViewBag.IntakeCode)
                        {
                            <option>@item</option>
                        }
                    }
                </optgroup>
                <optgroup label="Talent Pool Intakes">
                    @{
                        foreach (var item in (List<string>)ViewBag.TPCode)
                        {
                            <option>@item</option>
                        }
                    }
                </optgroup>
            </select>
        </div>

        <div class="d-flex align-items-center">
            <label id="JobPositionName" class="label-display me-4"></label>
            <input type="button" value="View" class="btn btn-primary btn-md ms-3" id="btnView" />
            <input type="button" value="View All" class="btn btn-primary btn-md ms-3" id="btnViewAll" />
        </div>

@*         <div class="flex-grow-1">
            <label id="JobPositionName" class="label-display"></label>
        </div>

        <div>
            <input type="button" value="View" class="btn btn-primary btn-md" id="btnView" />
        </div> *@
    </div>
</form>

<hr />

<div id="searchResults">
</div>

@section Scripts {

    <script src="~/lib/bootstrap-select/js/bootstrap-select.min.js"></script>

    <script>
        $(document).ready(function () {
            var url = '@Url.Action("ViewApplicantList", "IntakeApplicant")';
            $('#btnView').click(function() {
                loadApplicants(false);
            });

            $('#btnViewAll').click(function () {
                loadApplicants(true);
            });

            function loadApplicants(showAll) {
                var intakeCode = $('#IntakeCode').val();
                $('#searchResults').load(url, { intakeCode: intakeCode, showAll: showAll });
            }

            GetJobPositionName();

            $('#IntakeCode').on('change', function (ev)
            {
                GetJobPositionName();
            });

            function GetJobPositionName()
            {
                var intakeCode = $('#IntakeCode').val();
                //fetch('/IntakeApplicant/GetJobPositionName?intakeCode=' + intakeCode)
                fetch('@Url.Action("GetJobPositionName", "IntakeApplicant")' + '?intakeCode=' + intakeCode)
                    .then(response => response.json())
                    .then(data =>
                    {
                        var jobPositionName = data.jobPositionName;
                        $('#JobPositionName').text(jobPositionName);
                    });
            }

            //$('.my-select').selectpicker();
            //$('select').selectpicker();
            //$('#IntakeCode').selectpicker('toggle');

            //if ($(".selectpicker")[0]) {
            //    $(".selectpicker").selectpicker();
            //    $('.selectpicker').parents('form:first').validate().settings.ignore = ':not(select:hidden, input:visible, textarea:visible)';
            //}
        })
    </script>
}
