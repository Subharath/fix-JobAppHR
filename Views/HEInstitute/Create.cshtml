@model JobAppHR.Models.HEInstitute

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Create - Higher Education Institute</h3>
<div class="alert alert-info">
    <h5 style="text-align: center">@ViewBag.Message</h5>
</div>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="HEInstituteID" class="form-control" />
            <br />
            <div class="form-group">
                <label asp-for="HEInstituteName" class="control-label"></label>
                <input asp-for="HEInstituteName" class="form-control form-control-sm text-capitalize" maxlength="100"/>
                <span asp-validation-for="HEInstituteName" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        var val = '@ViewBag.Message';
        if (val != "")
            $('.alert').show();
        else
            $('.alert').hide();
    </script>
}
