@model JobAppHR.Models.HEInstitute

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit - Higher Education Institute</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="HEInstituteID" class="form-control" />
            <div class="form-group">
                <label asp-for="HEInstituteName" class="control-label"></label>
                <input asp-for="HEInstituteName" class="form-control form-control-sm text-capitalize" maxlength="100" />
                <span asp-validation-for="HEInstituteName" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
