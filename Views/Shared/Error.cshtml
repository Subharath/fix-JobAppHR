@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
{
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Error Details:</h4>
        <p>@ViewBag.ErrorMessage</p>
        
        @if (!string.IsNullOrEmpty(ViewBag.IntakeCode as string))
        {
            <hr>
            <p class="mb-0">Intake Code: <strong>@ViewBag.IntakeCode</strong></p>
            <p class="mb-0">You can try going back to the <a href="@Url.Action("Index", "FilterProcess", new { selectedIntakeCode = ViewBag.IntakeCode })">Filter Process page</a> and try again.</p>
        }
    </div>
}

@if (Model != null && Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<div class="mt-3">
    <a href="@Url.Action("Index", "FilterProcess")" class="btn btn-primary">Back to Filter Process</a>
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Home</a>
</div>
