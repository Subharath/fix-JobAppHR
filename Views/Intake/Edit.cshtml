@model JobAppHR.Models.Intake

<link href="~/lib/datepicker/css/bootstrap-datepicker.min.css" rel="stylesheet" />

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .bordered {
        border-radius: 10px;
        border: thin solid lightgrey;
        padding: 5px;
        margin: 0px;
    }
</style>

<h3>Edit - Intake</h3>
<div class="alert alert-info">
    <h5 style="text-align: center">@ViewBag.Message</h5>
</div>

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IntakeID" class="form-control" />
            <input type="hidden" asp-for="JobPositionID" class="form-control" />
            <div class="row">
                <div class="col-5 form-group">
                    <label asp-for="JobPositionID" class="control-label"></label>
                    <select asp-for="JobPositionID" class="form-control form-control-sm" asp-items="ViewBag.JobPosition" disabled></select>
                    <span asp-validation-for="JobPositionID" class="text-danger"></span>
                </div>
                <div class="col-2 form-group">
                    <label asp-for="StartDate" class="control-label"></label>
                    <input asp-for="StartDate" class="form-control form-control-sm" type="text" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col-2 form-group">
                    <label asp-for="ClosingDate" class="control-label"></label>
                    <input asp-for="ClosingDate" class="form-control form-control-sm" type="text" />
                    <span asp-validation-for="ClosingDate" class="text-danger"></span>
                </div>
                <div class="col-2 form-group">
                <label asp-for="AgeLimit" class="control-label"></label>
                    <input asp-for="AgeLimit" class="form-control form-control-sm" readonly />
                <span asp-validation-for="AgeLimit" class="text-danger"></span>
            </div>
            </div>
            <br />
            <div class="row">
                <div class="col-3 form-group">
                    <label asp-for="IntakeYearMonth" class="control-label"></label>
                    <input asp-for="IntakeYearMonth" class="form-control form-control-sm" readonly />
                    <span asp-validation-for="IntakeYearMonth" class="text-danger"></span>
                </div>           
                <div class="col-3 form-group">
                    <label asp-for="IntakeCode" class="control-label"></label>
                    <input asp-for="IntakeCode" class="form-control form-control-sm" readonly />
                    <span asp-validation-for="IntakeCode" class="text-danger"></span>
                </div>
                <div class="col-3 form-group">
                    <label asp-for="FilterMode" class="control-label"></label>
                    <input asp-for="FilterMode" class="form-control form-control-sm" readonly />
                    <span asp-validation-for="FilterMode" class="text-danger"></span>
                </div>
            </div>
            <br />
            Filtering Required By
            <div class="row bordered">
                <div class="form-group col-2">
                    <label asp-for="OLRequired" class="control-label"></label>
                    <div>
                        <input type="radio" asp-for="OLRequired" value="1" disabled /> Yes
                        <input type="radio" asp-for="OLRequired" value="0" disabled /> No
                    </div>
                    <span asp-validation-for="OLRequired" class="text-danger"></span>
                </div>
                <br />
                <div class="form-group col-2">
                    <label asp-for="ALRequired" class="control-label"></label>
                    <div>
                        <input type="radio" asp-for="ALRequired" value="1" disabled/> Yes
                        <input type="radio" asp-for="ALRequired" value="0" disabled /> No
                    </div>
                    <span asp-validation-for="ALRequired" class="text-danger"></span>
                </div>
                <br />
                <div class="form-group col-3">
                    <label asp-for="HERequired" class="control-label"></label>
                    <div>
                        <input type="radio" asp-for="HERequired" value="1" disabled /> Yes
                        <input type="radio" asp-for="HERequired" value="0" disabled /> No
                    </div>
                    <span asp-validation-for="HERequired" class="text-danger"></span>
                </div>
                <br />
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script src="~/lib/datepicker/js/bootstrap-datepicker.min.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            $("input[id$='Date']").datepicker(
                {
                    format: 'yyyy-mm-dd',
                    autoclose: true,
                });

                var val = '@ViewBag.Message';
                if (val != "")
                    $('.alert').show();
                else
                    $('.alert').hide();
        });
    </script>
}

