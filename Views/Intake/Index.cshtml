@model IEnumerable<JobAppHR.Models.IntakeViewModel>

@{
    ViewData["Title"] = "Intakes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    table.dataTable thead tr {
        background-color: lightgrey;
    }
</style>

<h1>@ViewData["Title"]</h1>
<p>
    <a asp-action="Create" class="btn btn-outline-primary btn-sm"><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Create New</a>
</p>
<div class="alert alert-info">
    <h5 style="text-align: center">@ViewBag.Message</h5>
</div>
<table class="table table-striped table-bordered dt-responsive compact nowrap" id="datagrid">
    <thead>
        <tr>
            @*<th>
            @Html.DisplayNameFor(model => model.IntakeID)
            </th>*@
            @* <th>
            @Html.DisplayNameFor(model => model.JobPositionID)
            </th>*@
            <th>
                @Html.DisplayNameFor(model => model.IntakeCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobPositionName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClosingDate)
            </th>
            <th>
                @*@Html.DisplayNameFor(model => model.IntakeYearMonth)*@
                Year/Month
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinalConfirmed)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                @*<td>
                @Html.DisplayFor(modelItem => item.IntakeID)
                </td>*@
                    @*<td>
                @Html.DisplayFor(modelItem => item.JobPositionID)
                </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.IntakeCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.JobPositionName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StartDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ClosingDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IntakeYearMonth)
                </td>
                <td>
                    @(item.FinalConfirmed == 1 ? "YES" : "NO")
                    @*@Html.DisplayFor(modelItem => item.FinalConfirmed)*@
                </td>
                @*<td>
            @item.IntakeYearMonth.ToString("MMM yyyy")
            </td>*@
                <td>
                    @{
                        if (@item.FinalConfirmed == 0)
                        {
                            @Html.ActionLink(" ", "Edit", new { id=item.IntakeID }, new { @class="fa fa-pencil", @style="text-decoration:none;", title = "Edit" })
                        }
                    }
                    @Html.ActionLink(" ", "Details", new { intakeCode = item.IntakeCode, jobPositionName = item.JobPositionName }, new { @class="fa fa-info-circle", @style="text-decoration:none;", title = "Details", target = "_blank" })
                    @*@Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })*@
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#datagrid').DataTable({
                "pageLength": 50,
                columnDefs: [
                    { targets: [$('thead tr th').length - 1], "orderable": false, }
                ],
                order: { idx: 2, dir: 'desc' }
            });

            var val = '@ViewBag.Message';
            if (val != "")
                $('.alert').show();
            else
                $('.alert').hide();
        });

    </script>
}
