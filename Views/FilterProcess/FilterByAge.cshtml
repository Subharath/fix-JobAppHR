@model IEnumerable<JobAppHR.Models.AgeFilter>

@{
    ViewData["Title"] = "Filter By Age";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int i = 0;
}


<h4>@ViewData["Title"]</h4>


<form id="form" asp-action="UpdateAgeFilter" method="post">
    @Html.Label("Intake Code")
    <input type="text" value="@ViewBag.IntakeCode" id="intakeCode" name="intakeCode" style="border:none; font-weight:bold; width:150px" readonly />
    @Html.ActionLink(" ","Details","Intake",new {intakeCode = @ViewBag.IntakeCode}, new { @class="fa fa-info-circle", @style="text-decoration:none; font-size:large", title="Intake Details", target = "_blank"})

    <div id="tableLoader" class="position-absolute top-50 start-50 translate-middle text-center z-3" style="margin-top: 50px;">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-muted mt-3 fw-semibold">Loading applicant data...</p>
    </div>

    <div class="table-shell" style="visibility: hidden;">
    <table class="table table-striped table-bordered dt-responsive compact" id="datagrid" style="width:100%">
        <thead>
        <tr>           
            <th>
                @Html.DisplayNameFor(model => model.ApplicationCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NameWithInitials)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NIC)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DOB)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Age)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CurrentStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Remarks)
            </th>            
        </tr>
    </thead>
        <tbody>
        @foreach (var item in Model) 
        {
            <tr>            
                <td>
                    @*@Html.DisplayFor(modelItem => item.ApplicationCode)*@
                    @Html.ActionLink(item.ApplicationCode,"ViewApplicantData","IntakeApplicant",new {applicationCode = item.ApplicationCode}, new { target = "_blank" })
                    <input type="hidden" name="ApplicationCode" value="@item.ApplicationCode" />
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NameWithInitials)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NIC)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DOB)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Age)
                </td>
                <td>
                    <input type="checkbox" name="status_@i" id="status_@i" checked /> OK
                    <input type="hidden" name="CurrentStatus" id="currentstatus_@i" value="PASS" />
                </td>
                <td>
                    @*<input type="text" name="Remarks" value="@item.Remarks" />*@
                    <input name="Remarks" id="remarks_@i" value="@item.Remarks" />
                </td>
            </tr>
            i++;
        }
    </tbody>
    </table>
    </div>

    <div class="d-flex justify-content-end align-items-center mt-4 pt-3 border-top">
        <button id="btnProceed" type="submit" class="btn btn-success shadow-modern-sm">Proceed With Selected List</button>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function() 
        {
            $('#datagrid').DataTable(
            {
                "paging": false,
                columnDefs: [
                    { targets: [0], "orderable": false },
                    { targets: [$('thead tr th').length - 1],"orderable": false,}
                ],
                initComplete: function() {
                    $('.table-shell').css('visibility', 'visible').hide().fadeIn(300);
                    $('#tableLoader').fadeOut(200);
                }
            });

            $('input[type="checkbox"]').change(function (event) 
            { 
                var ctrlId = $(this).attr('id');
                var statusId = "#currentstatus_" + ctrlId.substring(7);
                var remarksId = "#remarks_" + ctrlId.substring(7);

                if (this.checked)
                {
                    $(statusId).val("PASS");
                }
                else 
                {
                    $(statusId).val("FAIL");
                }
            });

            $('input[type="search"]').on('input', function () {

                if ($(this).val() != "") {
                    $("#btnProceed").prop("disabled", true);
                }
                else {
                    $("#btnProceed").prop("disabled", false);
                }
            });
        });
    </script>
}
