@model IEnumerable<JobAppHR.Models.FilterProgress>

@{
    ViewData["Title"] = "View Progress";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h4>Filtering Progress of <small class="text-muted">@Model.First().ApplicationCode</small></h4>

<table class="table table-striped table-bordered dt-responsive compact nowrap">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Stage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Remarks)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedOn)
            </th>
        </tr>
    </thead>
    
    <tbody>
        @foreach (var item in Model) {
            <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Stage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Remarks)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedOn)
            </td>
        </tr>
        }
    </tbody>
</table>
