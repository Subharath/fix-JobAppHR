<link href="~/lib/bootstrap-select/css/bootstrap-select.min.css" rel="stylesheet" />

<form asp-action="ViewApplicantList">
    <div><h6>Start filtering process for Intakes which are set to AUTO filtering mode</h6></div>
    <br />
    <br />
    <div class="form-group d-flex align-items-center">
        <div class="me-4">
            <label class="control-label">Select Intake Code</label>
        </div>
        <div class="me-4">
@*             <select name="IntakeCode" id="IntakeCode" class="form-select form-select-sm"
                    asp-items="@ViewBag.IntakeCode">
            </select> *@
            <select name="IntakeCode" id="IntakeCode" class="selectpicker">
                <optgroup label="Normal Intakes">
                    @{
                        foreach (var item in (List<string>)ViewBag.IntakeCode)
                        {
                            var isSelected = !string.IsNullOrEmpty(ViewBag.SelectedIntakeCode) && item == ViewBag.SelectedIntakeCode;
                            <option selected="@isSelected">@item</option>
                        }
                    }
                </optgroup>
                <optgroup label="Talent Pool Intakes">
                    @{
                        foreach (var item in (List<string>)ViewBag.TPCode)
                        {
                            var isSelected = !string.IsNullOrEmpty(ViewBag.SelectedIntakeCode) && item == ViewBag.SelectedIntakeCode;
                            <option selected="@isSelected">@item</option>
                        }
                    }
                </optgroup>
            </select>
        </div>
        <div class="d-flex align-items-center">
            <label id="JobPositionName" class="label-display me-4"></label>
            <input type="button" value="View" class="btn btn-primary btn-sm ms-3" id="btnView" />
        </div>
    </div>
</form>

<hr />

<div id="searchResults">
</div>

@section Scripts {
    <script src="~/lib/bootstrap-select/js/bootstrap-select.min.js"></script>

    <script>
        $(document).ready(function () {

            if ('@ViewBag.IsSelected' == "YES")
            {
                loadResult();
            }

            GetJobPositionName();

            $('#IntakeCode').on('change', function () {
                GetJobPositionName();
            });

            $('#btnView').click(function () {
                var intakeCode = $('#IntakeCode').val();
                if (intakeCode) {
                    // Navigate to URL with selectedIntakeCode parameter
                    // This ensures URL state matches UI state
                    window.location = '@Url.Action("Index", "FilterProcess")' + '?selectedIntakeCode=' + encodeURIComponent(intakeCode);
                }
            });

            function loadResult()
            {
                var url = '@Url.Action("ViewSummary", "FilterProcess")';
                var intakeCode = $('#IntakeCode').val();
                $('#searchResults').load(url, { intakeCode: intakeCode });
            }

            function GetJobPositionName()
            {
                var intakeCode = $('#IntakeCode').val();
                fetch('@Url.Action("GetJobPositionName", "FilterProcess")' + '?intakeCode=' + intakeCode)
                    .then(response => response.json())
                    .then(data =>
                    {
                        $('#JobPositionName').text(data.jobPositionName);
                    });
            }
        })
    </script>
}
